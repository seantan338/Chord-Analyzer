        "required": [
          "analysis_id",
          "metadata",
          "music",
          "rhythm",
          "sections",
          "bars",
          "chords",
          "beginner_chords",
          "capo_suggestions",
          "capo_note",
          "waveform",
          "confidence",
          "warnings",
          "view"
