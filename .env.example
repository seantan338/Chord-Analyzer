# Copy to backend/.env (backend vars) and frontend/.env.local (NEXT_PUBLIC_* vars).
# Never commit real secrets.

# ================================================================ backend
# development | production | test
APP_ENV=development
LOG_LEVEL=INFO

# Where the SQLite database and temporary uploads live (TMP_DIR defaults to $DATA_DIR/tmp)
DATA_DIR=./data

# Upload / audio limits (900 s = 15 minutes)
MAX_UPLOAD_MB=50
MIN_DURATION_SECONDS=5
MAX_DURATION_SECONDS=900
# Safety-net cleanup for orphaned temp files
TEMP_FILE_TTL_MINUTES=60

# Job execution: "process" (isolated process per job, hard timeout) or "inline" (debug only)
JOB_RUNNER=process
JOB_TIMEOUT_SECONDS=300
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20

# Chord vocabulary: "majmin" (24 triads) or "extended" (adds 7ths/sus/slash when confident)
CHORD_VOCABULARY=extended

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Optional shared secret. When set, /api/* (except /api/health) requires header X-API-Key.
API_KEY=
# Per client IP; 0 disables
RATE_LIMIT_ANALYZE_PER_MINUTE=10
RATE_LIMIT_READ_PER_MINUTE=300
# Set true only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ================================================================ frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
